# Copy of the secret NAMES this app needs. The values here are placeholders.
# Real values go into Cloudflare (Settings > Variables and Secrets), never into this repo.
# For local development only, put real/test values in a file called .dev.vars (it is git-ignored).

# The passcode you type to open the dashboard. Pick something long.
DASHBOARD_PASSCODE=choose-a-long-passcode

# From your Etsy developer app (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret

# Optional. Only needed for the weekly "Claude briefing". The app works without it.
ANTHROPIC_API_KEY=
